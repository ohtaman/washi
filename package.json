{
  "name": "@ohtaman/washi",
  "version": "1.0.1",
  "description": "WaSHI: WebAssembly Algebraic System for Hybrid & Integer modeling (LP, MIP, QP, SMT)",
  "type": "module",
  "main": "./dist/lib/washi.js",
  "module": "./dist/lib/washi.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/lib/washi.js",
      "default": "./dist/lib/washi.js"
    },
    "./solvers/z3": {
      "types": "./dist/types/modeler/solvers/z3.d.ts",
      "import": "./dist/lib/solvers/z3.js",
      "default": "./dist/lib/solvers/z3.js"
    },
    "./solvers/glpk": {
      "types": "./dist/types/modeler/solvers/glpk.d.ts",
      "import": "./dist/lib/solvers/glpk.js",
      "default": "./dist/lib/solvers/glpk.js"
    }
  },
  "files": [
    "dist/lib",
    "dist/types",
    "README.md",
    "README.ja.md",
    "README.zh-CN.md",
    "LICENSE",
    "THIRD_PARTY_LICENSES.md"
  ],
  "scripts": {
    "dev": "vite",
    "build:demo": "vite build",
    "build:types": "tsc -p tsconfig.lib.json",
    "build:lib": "vite build --config vite.config.lib.ts",
    "build": "npm run build:types && npm run build:lib && npm run build:demo",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "vitest run test/e2e.test.ts",
    "prepublishOnly": "npm run build:types && npm run build:lib"
  },
  "keywords": [
    "optimization",
    "mathematical-programming",
    "linear-programming",
    "mixed-integer-programming",
    "quadratic-programming",
    "lp",
    "mip",
    "qp",
    "highs",
    "pulp",
    "wasm",
    "webassembly",
    "typescript"
  ],
  "author": "",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ohtaman/washi.git"
  },
  "bugs": {
    "url": "https://github.com/ohtaman/washi/issues"
  },
  "homepage": "https://github.com/ohtaman/washi#readme",
  "dependencies": {
    "highs": "^1.15.3"
  },
  "peerDependencies": {
    "glpk.js": "^5.0.0",
    "z3-solver": "^5.2.0"
  },
  "peerDependenciesMeta": {
    "glpk.js": {
      "optional": true
    },
    "z3-solver": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "glpk.js": "^5.0.0",
    "playwright": "^1.63.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2",
    "z3-solver": "^5.2.0"
  }
}
