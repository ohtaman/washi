{
  "name": "@ohtaman/washi",
  "version": "0.3.0",
  "description": "WaSHI: WebAssembly-backed, Solver-independent, High-level modeling Interface (LP, MIP, QP, SMT)",
  "type": "module",
  "main": "./dist/lib/washi.js",
  "module": "./dist/lib/washi.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/lib/washi.js",
      "default": "./dist/lib/washi.js"
    },
    "./highs.wasm": "./dist/lib/highs.wasm",
    "./solvers/z3": {
      "types": "./dist/types/modeler/solvers/z3/index.d.ts",
      "import": "./dist/lib/solvers/z3.js",
      "default": "./dist/lib/solvers/z3.js"
    },
    "./solvers/glpk": {
      "types": "./dist/types/modeler/solvers/glpk/index.d.ts",
      "import": "./dist/lib/solvers/glpk.js",
      "default": "./dist/lib/solvers/glpk.js"
    },
    "./browser": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/browser/washi.js",
      "default": "./dist/browser/washi.js"
    },
    "./browser/washi.min.js": "./dist/browser/washi.min.js",
    "./browser/solvers/glpk": {
      "types": "./dist/types/modeler/solvers/glpk/index.d.ts",
      "import": "./dist/browser/solvers/glpk.js",
      "default": "./dist/browser/solvers/glpk.js"
    },
    "./browser/solvers/glpk.min.js": "./dist/browser/solvers/glpk.min.js",
    "./browser/solvers/z3": {
      "types": "./dist/types/modeler/solvers/z3/index.d.ts",
      "import": "./dist/browser/solvers/z3.js",
      "default": "./dist/browser/solvers/z3.js"
    },
    "./browser/solvers/z3.min.js": "./dist/browser/solvers/z3.min.js",
    "./solvers/z3-built.js": "./dist/lib/solvers/z3-built.js",
    "./solvers/z3-built.wasm": "./dist/lib/solvers/z3-built.wasm"
  },
  "files": [
    "dist/lib",
    "dist/browser",
    "dist/types",
    "README.md",
    "README.ja.md",
    "README.zh-CN.md",
    "LICENSE",
    "THIRD_PARTY_LICENSES.md"
  ],
  "scripts": {
    "dev": "vite",
    "build:demo": "vite build",
    "build:types": "node -e \"import('node:fs').then(fs => fs.rmSync('dist/types', { recursive: true, force: true }))\" && tsc -p tsconfig.lib.json",
    "build:lib": "node scripts/build-library.mjs",
    "build": "npm run build:types && npm run build:lib && npm run build:browser && npm run build:demo",
    "build:site": "node scripts/build-site.mjs",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "RUN_E2E=1 vitest run test/e2e.test.ts",
    "prepublishOnly": "npm run build:types && npm run build:lib && npm run build:browser",
    "build:browser": "node scripts/build-browser.mjs",
    "test:distribution": "npm run build:types && npm run build:lib && npm run build:browser && node --experimental-vm-modules scripts/check-distribution.mjs",
    "test:demo": "BASE_URL=/washi/ npm run build:demo && node scripts/check-demo-browser.mjs"
  },
  "keywords": [
    "optimization",
    "mathematical-programming",
    "linear-programming",
    "mixed-integer-programming",
    "quadratic-programming",
    "lp",
    "mip",
    "qp",
    "highs",
    "pulp",
    "wasm",
    "webassembly",
    "typescript"
  ],
  "author": "",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ohtaman/washi.git"
  },
  "bugs": {
    "url": "https://github.com/ohtaman/washi/issues"
  },
  "homepage": "https://github.com/ohtaman/washi#readme",
  "dependencies": {
    "highs": "^1.15.3"
  },
  "peerDependencies": {
    "glpk.js": "^5.0.0",
    "z3-solver": "^5.2.0"
  },
  "peerDependenciesMeta": {
    "glpk.js": {
      "optional": true
    },
    "z3-solver": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "glpk.js": "^5.0.0",
    "mermaid": "^11.17.2",
    "playwright": "^1.63.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitepress": "^1.6.4",
    "vitepress-plugin-mermaid": "^2.0.17",
    "vitest": "^5.0.2",
    "webpack": "^5.111.1",
    "z3-solver": "^5.2.0"
  },
  "jsdelivr": "./dist/browser/washi.min.js",
  "unpkg": "./dist/browser/washi.min.js"
}
